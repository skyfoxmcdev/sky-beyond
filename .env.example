# ---------------------------------------------------------------------------
# Sky & Beyond : variables d'environnement
# Copiez ce fichier vers .env.local et renseignez les valeurs officielles.
# Aucune valeur ci-dessous n'est un secret : toutes finissent dans le HTML.
# Les valeurs NEXT_PUBLIC_* sont figées au build : relancez `npm run build`
# (ou redéployez sur Vercel) après chaque modification.
# ---------------------------------------------------------------------------

# URL publique canonique du site, sans slash final.
# En local : http://localhost:3000
# En production : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=https://skyandbeyond.example

# Invitation Discord officielle (HTTPS, discord.gg ou discord.com uniquement).
# Laissez vide tant que l'invitation n'est pas confirmée : le site affichera
# un état d'attente au lieu d'un lien cassé.
NEXT_PUBLIC_DISCORD_URL=

# Adresse Minecraft publique, avec port si nécessaire.
# Exemple : play.skyandbeyond.fr ou play.skyandbeyond.fr:25565
# Laissez vide tant que l'adresse n'est pas confirmée : le statut sera inconnu
# et le bouton de copie sera masqué.
NEXT_PUBLIC_MC_SERVER_ADDRESS=

# Version Minecraft affichée aux joueurs.
# Exemple : 1.20.1
# Laissez vide tant que la version n'est pas confirmée.
NEXT_PUBLIC_MC_VERSION=

# Logo officiel : placez le fichier dans public/brand/ puis indiquez son chemin.
# Le logo fourni n'est ni redessiné ni recadré par le site.
# Exemple : /brand/logo-officiel.png
NEXT_PUBLIC_LOGO_SRC=

# Dimensions intrinsèques du logo officiel, en pixels (ratio préservé).
NEXT_PUBLIC_LOGO_WIDTH=184
NEXT_PUBLIC_LOGO_HEIGHT=48
